# Copy to .env and fill in — this file is never committed (see .gitignore).

# Supabase — service role key only, never the anon key, never sent to a frontend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (Vite) — anon key only, scoped entirely by RLS. Safe to ship to the
# browser, but still kept out of git for consistency with the rest of this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
